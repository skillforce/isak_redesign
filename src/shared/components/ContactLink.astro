---
import Icon from "./Icon.astro";
interface Props {
  href: string;
  label: string;
  note?: string;
  tone?: "light" | "dark";
  "data-contact-type"?: string;
  "data-contact-base"?: string;
}

const { href, label, note, tone = "light", ...rest } = Astro.props;
const external = href.startsWith("http");
---

<a
  href={href}
  class:list={["contact-link", `contact-link--${tone}`]}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  data-contact-type={rest["data-contact-type"]}
  data-contact-base={rest["data-contact-base"]}
>
  <span class="contact-text">
    <span class="contact-label">{label}</span>
    {note && <span class="contact-note">{note}</span>}
  </span>
  <span class="contact-arrow"><Icon size={18} /></span>
</a>

<style>
  .contact-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding: 12px 0;
    border-bottom: 1px solid var(--c-line);
    text-decoration: none;
    transition:
      padding var(--t) var(--ease),
      color var(--t) var(--ease);
  }

  .contact-link--dark {
    border-bottom-color: var(--c-graphite);
  }

  .contact-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .contact-label {
    font-weight: 600;
    font-size: 18px;
    line-height: 1.3;
  }

  .contact-note {
    font-size: 14px;
    line-height: 1.4;
    color: var(--c-muted);
  }

  .contact-link--dark .contact-note {
    color: var(--c-line);
  }

  .contact-arrow {
    font-family: var(--f-mono);
    font-size: 18px;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border: 1px solid currentColor;
    transition:
      background-color var(--t) var(--ease),
      color var(--t) var(--ease);
  }

  .contact-link:hover .contact-arrow {
    background: var(--c-accent);
    border-color: var(--c-accent);
    color: var(--c-ink);
  }

  .contact-link:hover {
    padding-left: 6px;
  }
</style>
