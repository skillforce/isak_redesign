---
interface Props {
  tone?: "paper" | "ink" | "acid" | "accent";
  shape?: "cut" | "tape";
  size?: "label" | "heading";
  icon?: "target" | "arrow" | "play" | "check";
  tilt?: "left" | "right" | "none";
}

const {
  tone = "paper",
  shape = "cut",
  size = "label",
  icon,
  tilt = "left",
} = Astro.props;

const outlines = {
  cut: "M14 2H305L318 16V64L305 78H15L2 64V16Z",
  tape: "M6 7L309 2L318 12L314 72L12 78L2 67Z",
};

const icons = {
  target: "M12 2v5m0 10v5M2 12h5m10 0h5M17 12a5 5 0 1 1-10 0 5 5 0 0 1 10 0Z",
  arrow: "M5 19 19 5M5 5h14v14",
  play: "m8 5 11 7-11 7Z",
  check: "m5 12 5 5L20 6",
};
---

<span
  class:list={[
    "sticker",
    `sticker--${tone}`,
    `sticker--${shape}`,
    `sticker--${size}`,
    `sticker--${tilt}`,
  ]}
>
  <svg
    class="sticker__outline"
    viewBox="0 0 320 80"
    preserveAspectRatio="none"
    aria-hidden="true"
    focusable="false"
  >
    <path d={outlines[shape]} vector-effect="non-scaling-stroke"></path>
  </svg>
  <span class="sticker__content">
    {
      icon && (
        <svg
          class="sticker__icon"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path d={icons[icon]} />
        </svg>
      )
    }
    <span><slot /></span>
  </span>
</span>

<style>
  .sticker {
    --sticker-fill: var(--c-ivory);
    --sticker-color: var(--c-ink);
    --sticker-angle: -1.5deg;
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    width: fit-content;
    max-width: 100%;
    padding: 0.17em 0.4em 0.23em;
    color: var(--sticker-color);
    font: inherit;
    vertical-align: middle;
    transform: rotate(var(--sticker-angle));
  }

  .sticker--ink {
    --sticker-fill: var(--c-ink);
    --sticker-color: var(--c-ivory);
  }

  .sticker--acid {
    --sticker-fill: var(--c-citron);
  }

  .sticker--accent {
    --sticker-fill: var(--c-accent);
    --sticker-color: var(--c-ivory);
  }

  .sticker--accent.sticker--label {
    --sticker-color: var(--c-ink);
  }

  .sticker--right {
    --sticker-angle: 1.5deg;
  }

  .sticker--none {
    --sticker-angle: 0deg;
  }

  .sticker__outline {
    position: absolute;
    z-index: -1;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: var(--sticker-fill);
    stroke: var(--c-ink);
    stroke-width: 1.25;
    filter: drop-shadow(2px 3px 0 var(--c-ink));
    pointer-events: none;
  }

  .sticker--ink .sticker__outline {
    stroke: var(--c-ivory);
  }

  .sticker__content {
    display: inline-flex;
    align-items: center;
    gap: 0.65em;
    min-width: 0;
  }

  .sticker__content > span {
    min-width: 0;
  }

  .sticker__icon {
    flex: 0 0 auto;
    width: 1.3em;
    height: 1.3em;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: square;
    stroke-linejoin: miter;
  }

  .sticker--label {
    padding: 0.65em 1.1em 0.75em;
    font-family: var(--f-heading);
    font-size: clamp(12px, 1.05vw, 14px);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.025em;
    text-transform: none;
  }

  .sticker--heading {
    margin-block: 0.035em 0.075em;
  }

  .sticker--heading .sticker__content {
    gap: 0.2em;
  }

  .sticker--heading .sticker__icon {
    width: 0.75em;
    height: 0.75em;
  }

  @media (min-width: 1024px) {
    .sticker--label {
      letter-spacing: -0.01em;
    }
  }

  @media (forced-colors: active) {
    .sticker {
      color: CanvasText;
      border: 1px solid CanvasText;
    }
    .sticker__outline {
      display: none;
    }
  }
</style>
