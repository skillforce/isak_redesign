---
import {
  Modal as FreeModal,
  ModalBody,
  ModalHeader,
} from "free-astro-components";

import { MODAL_DATA } from "../data/modal_data";
import ContactLink from "./ContactLink.astro";
import BrandText from "./BrandText.astro";

interface Props {
  id: string;
}
const { id } = Astro.props;
---

<script>
  import {
    buildContactLink,
    buildOrderMessage,
    copyText,
  } from "../utils/order";
  import type { ContactType } from "../data/modal_data";

  let currentMessage = "";

  document.addEventListener("click", (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const trigger = target.closest("[data-modal-trigger]");
    if (!(trigger instanceof HTMLElement)) return;

    const toolName = trigger.dataset.modalName;
    const explicit = trigger.dataset.modalMessage;
    if (!toolName && !explicit) return;

    const message = explicit || buildOrderMessage(toolName!);
    currentMessage = message;

    document
      .querySelectorAll<HTMLAnchorElement>("[data-contact-type]")
      .forEach((link) => {
        const type = link.dataset.contactType as ContactType | undefined;
        const base = link.dataset.contactBase;
        if (!type || !base) return;
        link.href = buildContactLink(type, base, message);
      });

    const preview = document.querySelector<HTMLElement>("[data-order-preview]");
    if (preview) {
      const parts = message.split(/(Гера2)/g).map((part) => {
        if (part !== "Гера2") return document.createTextNode(part);
        const brand = document.createElement("span");
        brand.className = "order-brand";
        brand.append("Гера");
        const number = document.createElement("span");
        number.className = "brand-number";
        number.textContent = "2";
        brand.append(number);
        return brand;
      });
      preview.replaceChildren(...parts);
    }
    const status = document.querySelector<HTMLElement>("[data-preview-status]");
    if (status) status.textContent = "";
  });

  document
    .querySelector<HTMLButtonElement>("[data-preview-copy]")
    ?.addEventListener("click", async () => {
      const status = document.querySelector<HTMLElement>(
        "[data-preview-status]"
      );
      const ok = currentMessage ? await copyText(currentMessage) : false;
      if (status) {
        status.textContent = ok
          ? "Скопировано"
          : "Выделите текст выше и скопируйте вручную";
      }
    });
</script>

<FreeModal id={id} class="contact_modal" size="lg">
  <ModalHeader>
    <span class="t-label modal-label">Связь с продавцом</span>
    <span class="modal-title">Обсудить заказ</span>
  </ModalHeader>
  <ModalBody>
    <div class="contact_modal_body">
      <div class="preview">
        <p class="t-label preview-label">Текст заявки</p>
        <p class="preview-text" data-order-preview>
          <BrandText text="Здравствуйте! Хотел бы заказать аппарат Гера2" />
        </p>
        <div class="preview-actions">
          <button type="button" class="preview-copy" data-preview-copy>
            Скопировать текст
          </button>
          <span class="preview-status" aria-live="polite" data-preview-status
          ></span>
        </div>
      </div>
      <ul class="contact-list">
        {
          MODAL_DATA.CONTACTS.map((contact) => (
            <li>
              <ContactLink
                href={contact.href}
                label={contact.label}
                note={contact.note}
                data-contact-type={contact.type}
                data-contact-base={contact.href}
              />
            </li>
          ))
        }
      </ul>
    </div>
  </ModalBody>
</FreeModal>

<script define:vars={{ id }}>
  const onDOMReady = (callback) => {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", callback, { once: true });
      return;
    }
    callback();
  };

  const isIOS164OrLower = () => {
    const ua = navigator.userAgent;
    const isIOSDevice =
      /iP(ad|hone|od)/.test(ua) ||
      (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);

    if (!isIOSDevice) return false;

    const osMatch = ua.match(/OS (\d+)[._](\d+)/);
    if (osMatch) {
      const major = Number(osMatch[1]);
      const minor = Number(osMatch[2]);
      return major < 16 || (major === 16 && minor <= 4);
    }

    const versionMatch = ua.match(/Version\/(\d+)\.(\d+)/);
    if (!versionMatch) return false;

    const major = Number(versionMatch[1]);
    const minor = Number(versionMatch[2]);
    return major < 16 || (major === 16 && minor <= 4);
  };

  const resetModalState = (modal) => {
    modal.classList.add("ac-modal--close");
    modal.style.removeProperty("transform");
    modal.style.removeProperty("opacity");
    modal.style.removeProperty("transition");
    document.body.style.overflow = "auto";
    document.documentElement.style.overflow = "auto";
  };

  const disableLibraryTouchControls = (modal) => {
    modal.removeEventListener("touchstart", modal.handleTouchStart);
    modal.removeEventListener("touchmove", modal.handleTouchMove);
    modal.removeEventListener("touchend", modal.handleTouchEnd);
  };

  const hardHideModal = (modal) => {
    modal.setAttribute("hidden", "");
    modal.style.display = "none";
    modal.style.pointerEvents = "none";
  };

  const hardShowModal = (modal) => {
    modal.removeAttribute("hidden");
    modal.style.removeProperty("display");
    modal.style.removeProperty("pointer-events");
  };

  const setupModalIOSFallback = (modalId) => {
    const modal = document.getElementById(modalId);
    if (!(modal instanceof HTMLDialogElement)) return;

    if (!isIOS164OrLower()) return;

    const syncVisibilityState = () => {
      if (modal.open) {
        modal.classList.remove("ac-modal--close");
        hardShowModal(modal);
        disableLibraryTouchControls(modal);
        return;
      }

      resetModalState(modal);
      hardHideModal(modal);
    };

    modal.addEventListener("close", () => {
      resetModalState(modal);
    });

    const forceClose = () => {
      let closedNatively = false;
      try {
        if (modal.open) {
          modal.close();
          closedNatively = true;
        }
      } catch {
        closedNatively = false;
      }

      modal.removeAttribute("open");
      resetModalState(modal);

      if (!closedNatively) {
        modal.dispatchEvent(new Event("close"));
      }
    };

    modal.querySelectorAll("[data-modal-close]").forEach((control) => {
      control.addEventListener(
        "touchend",
        (event) => {
          event.preventDefault();
          forceClose();
        },
        { passive: false }
      );
    });

    const observer = new MutationObserver(() => {
      syncVisibilityState();
    });

    observer.observe(modal, {
      attributes: true,
      attributeFilter: ["open"],
    });

    syncVisibilityState();
  };

  onDOMReady(() => setupModalIOSFallback(id));
</script>

<style>
  :global(.contact_modal[hidden]) {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  :global(.contact_modal.ac-modal--close) {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  :global(.contact_modal:not([open])) {
    display: none !important;
  }

  :global(.contact_modal) {
    background: var(--c-ivory);
    color: var(--c-ink);
    border-radius: 0;
    border-top: 6px solid var(--c-accent);
    font-family: var(--f-body);
  }

  :global(.contact_modal::backdrop) {
    background: rgb(23 23 21 / 0.72);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  :global(.contact_modal .ac-modal-close) {
    color: var(--c-ink);
    width: 44px;
    height: 44px;
    top: 10px;
    right: 10px;
    border-radius: 0;
  }

  :global(.contact_modal .ac-modal-close:hover) {
    background: var(--c-ink);
    color: var(--c-ivory);
  }

  :global(.contact_modal .ac-modal-header) {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 28px 28px 8px;
  }

  :global(.contact_modal .ac-modal-body) {
    padding: 12px 28px 28px;
  }

  .modal-label {
    color: var(--c-accent-hover);
  }

  .modal-title {
    font-family: var(--f-heading);
    font-weight: 800;
    font-size: clamp(28px, 5vw, 38px);
    line-height: 1.08;
    letter-spacing: -0.055em;
  }

  .contact_modal_body {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .preview {
    padding: 16px;
    background: var(--c-white);
    border: 1px solid var(--c-line);
  }

  .preview-label {
    color: var(--c-muted);
    margin-bottom: 8px;
  }

  .preview-text {
    font-size: 16px;
    line-height: 1.5;
    user-select: all;
    -webkit-user-select: all;
  }

  .preview-text :global(.order-brand) {
    white-space: nowrap;
  }

  .preview-text :global(.brand-number) {
    color: var(--c-accent);
    font-size: 0.65em;
    position: relative;
    top: -0.08em;
  }

  .preview-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 16px;
    margin-top: 8px;
  }

  .preview-copy {
    min-height: 44px;
    padding: 0;
    background: none;
    border: 0;
    font-weight: 600;
    font-size: 15px;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .preview-status {
    font-size: 14px;
    color: var(--c-muted);
  }

  .contact-list {
    border-top: 2px solid var(--c-ink);
  }

  @media (max-width: 639px) {
    :global(.contact_modal .ac-modal-header) {
      padding: 24px 16px 4px;
    }

    :global(.contact_modal .ac-modal-body) {
      padding: 12px 16px 24px;
    }

    .modal-title {
      font-size: 34px;
    }
  }
</style>
