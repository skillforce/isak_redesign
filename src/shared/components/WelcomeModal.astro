---
import {
  Modal as FreeModal,
  ModalBody,
  ModalHeader,
} from "free-astro-components";

import politicsPdf from "../../assets/politics/politics.pdf";

interface Props {
  id: string;
}

const { id } = Astro.props;
---

<FreeModal id={id} class="welcome_modal">
  <ModalHeader>Добро пожаловать!</ModalHeader>
  <ModalBody>
    <div class="welcome_modal_body">
      <div class="welcome_modal_text">
        Для корректной работы сайта и вашего удобства мы используем файлы
        cookie.
      </div>
      <div class="welcome_modal_text">
        Нажимая «Принять» или пользуясь этим сайтом, вы даёте согласие на
        обработку персональных данных и файлов cookie в соответствии с{" "}
        <a href={politicsPdf} target="_blank" rel="noopener noreferrer">
          Политикой обработки
        </a>{" "}
        этих данных.
      </div>
    </div>
    <div class="welcome_modal_button_container">
      <button type="button" class="accept_button" data-modal-close
        >Принять</button
      >
    </div>
  </ModalBody>
</FreeModal>

<script define:vars={{ id }}>
  const onDOMReady = (callback) => {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", callback, { once: true });
      return;
    }
    callback();
  };

  const isIOS164OrLower = () => {
    const ua = navigator.userAgent;
    const isIOSDevice =
      /iP(ad|hone|od)/.test(ua) ||
      (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);

    if (!isIOSDevice) return false;

    const osMatch = ua.match(/OS (\d+)[._](\d+)/);
    if (osMatch) {
      const major = Number(osMatch[1]);
      const minor = Number(osMatch[2]);
      return major < 16 || (major === 16 && minor <= 4);
    }

    const versionMatch = ua.match(/Version\/(\d+)\.(\d+)/);
    if (!versionMatch) return false;

    const major = Number(versionMatch[1]);
    const minor = Number(versionMatch[2]);
    return major < 16 || (major === 16 && minor <= 4);
  };

  const resetModalState = (modal) => {
    modal.classList.add("ac-modal--close");
    modal.style.removeProperty("transform");
    modal.style.removeProperty("opacity");
    modal.style.removeProperty("transition");
    document.body.style.overflow = "auto";
    document.documentElement.style.overflow = "auto";
  };

  const disableLibraryTouchControls = (modal) => {
    modal.removeEventListener("touchstart", modal.handleTouchStart);
    modal.removeEventListener("touchmove", modal.handleTouchMove);
    modal.removeEventListener("touchend", modal.handleTouchEnd);
  };

  const hardHideModal = (modal) => {
    modal.setAttribute("hidden", "");
    modal.style.display = "none";
    modal.style.pointerEvents = "none";
  };

  const hardShowModal = (modal) => {
    modal.removeAttribute("hidden");
    modal.style.removeProperty("display");
    modal.style.removeProperty("pointer-events");
  };

  const setupModalIOSFallback = (modalId) => {
    const modal = document.getElementById(modalId);
    if (!(modal instanceof HTMLDialogElement)) return;

    if (!isIOS164OrLower()) return;

    const syncVisibilityState = () => {
      if (modal.open) {
        modal.classList.remove("ac-modal--close");
        hardShowModal(modal);
        disableLibraryTouchControls(modal);
        return;
      }

      resetModalState(modal);
      hardHideModal(modal);
    };

    modal.addEventListener("close", () => {
      resetModalState(modal);
      hardHideModal(modal);
    });

    const forceClose = () => {
      let closedNatively = false;
      try {
        if (modal.open) {
          modal.close();
          closedNatively = true;
        }
      } catch {
        closedNatively = false;
      }

      modal.removeAttribute("open");
      resetModalState(modal);

      if (!closedNatively) {
        modal.dispatchEvent(new Event("close"));
      }
    };

    modal.querySelectorAll("[data-modal-close]").forEach((control) => {
      control.addEventListener(
        "touchend",
        (event) => {
          event.preventDefault();
          forceClose();
        },
        { passive: false }
      );
    });

    const observer = new MutationObserver(() => {
      syncVisibilityState();
    });

    observer.observe(modal, {
      attributes: true,
      attributeFilter: ["open"],
    });

    syncVisibilityState();
  };

  onDOMReady(() => setupModalIOSFallback(id));
</script>

<style>
  :global(.welcome_modal[hidden]) {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  :global(.welcome_modal.ac-modal--close) {
    display: none !important;
    visibility: hidden !important;
    opacity: 0 !important;
    pointer-events: none !important;
  }

  :global(.welcome_modal:not([open])) {
    display: none !important;
  }

  :global(dialog.welcome_modal) {
    --ac-modal-background-color: #fffdf8;
    background: #fffdf8;
    color: #111110;
    border-radius: 0;
    border-top: 6px solid var(--c-accent);
    font-family: var(--f-body);
  }

  :global(.welcome_modal::backdrop) {
    background: rgb(8 8 7 / 0.72);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }

  :global(.welcome_modal .ac-modal-close) {
    color: #111110;
    width: 44px;
    height: 44px;
    top: 10px;
    right: 10px;
    border-radius: 0;
  }

  :global(.welcome_modal .ac-modal-close:hover) {
    background: var(--c-graphite);
    color: var(--c-ivory);
  }

  :global(.welcome_modal .ac-modal-header) {
    color: #111110;
    font-family: var(--f-heading);
    font-weight: 800;
    font-size: 28px;
    line-height: 1.2;
    letter-spacing: -0.04em;
    text-transform: none;
    padding: 28px 64px 8px 28px;
  }

  :global(.welcome_modal .ac-modal-body) {
    color: #111110;
    background: #fffdf8;
    padding: 12px 28px 28px;
  }

  .welcome_modal_body {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 0 0 20px;
  }

  .welcome_modal_text {
    color: #222220;
    font-family: "Golos Text", sans-serif;
    font-size: 17px;
    line-height: 1.6;
  }

  .welcome_modal_text a {
    color: #111110;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .welcome_modal_button_container {
    display: flex;
  }

  .accept_button {
    min-height: 48px;
    padding: 12px 28px;
    border: 0;
    border-radius: 0;
    background: #111110;
    color: #ffffff;
    font-weight: 700;
    font-size: 18px;
    cursor: pointer;
    transition:
      background-color var(--t) var(--ease),
      color var(--t) var(--ease);
  }

  .accept_button:hover {
    background: #30302c;
    color: var(--c-white);
  }

  .accept_button:focus-visible {
    outline: 3px solid #111110;
    outline-offset: 3px;
  }

  @media (max-width: 639px) {
    :global(.welcome_modal .ac-modal-header) {
      font-size: 25px;
      padding: 24px 52px 8px 20px;
    }

    :global(.welcome_modal .ac-modal-body) {
      padding: 12px 20px 24px;
    }

    .welcome_modal_text {
      font-size: 16px;
    }

    .accept_button {
      width: 100%;
    }
  }
</style>
