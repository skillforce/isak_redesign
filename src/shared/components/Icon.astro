---
interface Props {
  name?: "arrow-up-right" | "arrow-right" | "play" | "compare";
  size?: number;
  class?: string;
}
const { name = "arrow-up-right", size = 20, class: className } = Astro.props;
---

<svg
  class:list={["icon", className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.65"
  stroke-linecap="square"
  stroke-linejoin="miter"
  aria-hidden="true"
  focusable="false"
>
  {name === "arrow-up-right" && <path d="M6 18 18 6M6 6h12v12" />}
  {name === "arrow-right" && <path d="M3 12h17m-7-7 7 7-7 7" />}
  {
    name === "play" && (
      <path d="m7 3 14 9-14 9Z" fill="currentColor" stroke="none" />
    )
  }
  {name === "compare" && <path d="m8 7-5 5 5 5m8-10 5 5-5 5" />}
</svg>

<style>
  .icon {
    flex: 0 0 auto;
  }
</style>
