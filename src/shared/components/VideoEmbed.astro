---
/**
 * YouTube facade: shows a local poster and loads the player (youtube-nocookie)
 * only after the visitor presses play. Without a video id it renders a static
 * preview with no player at all.
 */
interface Props {
  videoId?: string | null;
  poster?: ImageMetadata;
  fallback: ImageMetadata;
  title: string;
  index?: number;
  hidden?: boolean;
}

import { Image } from "astro:assets";
import { parseYouTubeId } from "../utils/youtube";

const {
  videoId,
  poster,
  fallback,
  title,
  index = 0,
  hidden = false,
} = Astro.props;

const parsed = parseYouTubeId(videoId);
let embedSrc: string | null = null;
if (parsed) {
  const params = new URLSearchParams(parsed.query);
  params.set("rel", "0");
  params.set("modestbranding", "1");
  params.set("playsinline", "1");
  embedSrc = `https://www.youtube-nocookie.com/embed/${parsed.key}?${params.toString()}`;
}
---

<script is:inline>
  (() => {
    if (window.__ytFacadeInitialized) return;
    window.__ytFacadeInitialized = true;

    const preconnectedHosts = new Set();
    const preconnect = (host) => {
      if (preconnectedHosts.has(host)) return;
      const link = document.createElement("link");
      link.rel = "preconnect";
      link.href = host;
      link.crossOrigin = "anonymous";
      document.head.append(link);
      preconnectedHosts.add(host);
    };

    const warmupConnections = () => {
      preconnect("https://www.youtube-nocookie.com");
      preconnect("https://www.google.com");
    };

    const activatePlayer = (container) => {
      if (!container || container.dataset.ready === "true") return;
      const src = container.dataset.src;
      if (!src) return;

      warmupConnections();

      const iframe = document.createElement("iframe");
      iframe.src = src + (src.includes("?") ? "&autoplay=1" : "?autoplay=1");
      iframe.title = container.dataset.title || "YouTube video player";
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture";
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = "strict-origin-when-cross-origin";

      container.querySelector("[data-youtube-stage]").replaceChildren(iframe);
      container.dataset.ready = "true";
      iframe.focus();
    };

    document.addEventListener("pointerover", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (target && target.closest("[data-youtube-play]")) {
        warmupConnections();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target instanceof Element ? event.target : null;
      const trigger = target && target.closest("[data-youtube-play]");
      if (!trigger) return;
      const container = trigger.closest("[data-youtube-facade]");
      activatePlayer(container);
    });
  })();
</script>

<div
  class="video"
  data-youtube-facade={embedSrc ? "" : undefined}
  data-src={embedSrc ?? undefined}
  data-title={title}
  data-video-index={index}
  hidden={hidden}
>
  <div class="video-stage" data-youtube-stage>
    {
      poster ? (
        <Image
          class="poster"
          src={poster}
          alt=""
          widths={[640, 960, 1280, 1600]}
          sizes="(max-width: 767px) 92vw, min(50vw, 720px)"
          format="avif"
          quality={70}
          loading="lazy"
        />
      ) : (
        <div
          class="poster-bg"
          style={`background-image:url(${fallback.src})`}
          aria-hidden="true"
        />
      )
    }

    <span class="yt-mark" aria-hidden="true">
      <span class="yt-icon"></span>YouTube
    </span>

    {
      embedSrc ? (
        <button
          type="button"
          class="play-button"
          aria-label={`Смотреть на YouTube: ${title}`}
          data-youtube-play
        >
          <span class="play-icon" aria-hidden="true" />
        </button>
      ) : (
        <p class="no-video">
          <span class="t-label">Видео скоро появится</span>
        </p>
      )
    }
  </div>

  {
    embedSrc && (
      <noscript>
        <iframe
          title={title}
          src={embedSrc}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
        />
      </noscript>
    )
  }
</div>

<style>
  .video {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--c-graphite);
    overflow: hidden;
  }

  .video[hidden] {
    display: none;
  }

  .video-stage {
    position: absolute;
    inset: 0;
  }

  /* Posters are ready-made 16:9 frames (scripts/make-video-posters.sh). */
  .poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* No poster: the fallback texture fills the block, blurred and darkened. */
  .poster-bg {
    position: absolute;
    inset: -40px;
    background-size: cover;
    background-position: center;
    filter: blur(28px) brightness(0.55) saturate(1.1);
  }

  .yt-mark {
    position: absolute;
    right: 24px;
    bottom: 22px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--f-body);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.04em;
    color: var(--c-white);
    text-shadow: 0 1px 8px rgb(0 0 0 / 0.5);
    pointer-events: none;
  }

  .yt-icon {
    width: 30px;
    height: 21px;
    background: var(--c-white);
    border-radius: 6px;
    position: relative;
  }

  .yt-icon::after {
    content: "";
    position: absolute;
    left: 12px;
    top: 6px;
    border-style: solid;
    border-width: 4.5px 0 4.5px 8px;
    border-color: transparent transparent transparent var(--c-ink);
  }

  .play-button {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    padding: 0;
    background: transparent;
    cursor: pointer;
    display: grid;
    place-items: center;
  }

  .play-icon {
    width: clamp(68px, 9.6vw, 136px);
    aspect-ratio: 1.45;
    border-radius: clamp(14px, 1.8vw, 24px);
    background: var(--c-accent);
    position: relative;
    box-shadow: 0 6px 24px rgb(0 0 0 / 0.35);
    transition:
      background-color var(--t) var(--ease),
      transform var(--t) var(--ease);
  }

  .play-icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-38%, -50%);
    border-style: solid;
    border-width: 0.9em 0 0.9em 1.5em;
    border-color: transparent transparent transparent var(--c-white);
    font-size: clamp(9px, 1.2vw, 17px);
  }

  .play-button:hover .play-icon {
    background: var(--c-accent-hover);
    transform: scale(1.04);
  }

  .play-button:focus-visible {
    outline: 3px solid var(--c-ivory);
    outline-offset: -6px;
  }

  .no-video {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: var(--c-line);
  }

  .no-video .t-label {
    padding: 8px 12px;
    border: 1px dashed var(--c-line);
    background: var(--c-ink);
  }

  .video :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 767px) {
    .yt-mark {
      right: 12px;
      bottom: 10px;
      font-size: 16px;
    }

    .yt-icon {
      width: 22px;
      height: 15px;
      border-radius: 4px;
    }

    .yt-icon::after {
      left: 9px;
      top: 4px;
      border-width: 3.5px 0 3.5px 6px;
    }
  }
</style>
