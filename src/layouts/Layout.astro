---
// Only the latin + cyrillic subsets of weights the page actually renders.
import "@fontsource/oswald/latin-700.css";
import "@fontsource/oswald/cyrillic-700.css";
import "@fontsource/anton/latin-400.css";
import "@fontsource/roboto/latin-400.css";
import "@fontsource/roboto/cyrillic-400.css";
import "@fontsource/roboto/latin-500.css";
import "@fontsource/roboto/cyrillic-500.css";
import "@fontsource/roboto/latin-600.css";
import "@fontsource/roboto/cyrillic-600.css";
import "@fontsource/roboto/latin-700.css";
import "@fontsource/roboto/cyrillic-700.css";
import "@fontsource/roboto-condensed/latin-400.css";
import "@fontsource/roboto-condensed/cyrillic-400.css";
import "@fontsource/golos-text/latin-400.css";
import "@fontsource/golos-text/cyrillic-400.css";
import "@fontsource/golos-text/latin-600.css";
import "@fontsource/golos-text/cyrillic-600.css";
import "@fontsource/golos-text/latin-800.css";
import "@fontsource/golos-text/cyrillic-800.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/cyrillic-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@fontsource/ibm-plex-mono/cyrillic-500.css";
import "../styles/reset.css";
import "../styles/global.css";
import { getImage } from "astro:assets";
import heroDesktop from "../assets/metal/hero-desktop.png";
import { TOOL_OPTIONS, priceRange } from "../shared/data/mediaSectionData";

const minPriceBY = Math.min(
  ...TOOL_OPTIONS.map((t) => priceRange(t, "BY").min)
);
const title = `Гера2: пескоструйный аппарат для удаления ржавчины от ${minPriceBY} BYN`;
const description = `Компактные пескоструйные аппараты Гера2 для точечного удаления ржавчины и краски: модели ${TOOL_OPTIONS.map((t) => t.toolName).join(", ")} от ${minPriceBY} BYN. Подберите комплектацию и закажите.`;
const socialTitle =
  "Гера2 — пескоструйный аппарат для точечного удаления ржавчины";

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
// Social previews use 1.91:1; the source is only 1024px wide, so stay within it.
const ogImage = await getImage({
  src: heroDesktop,
  width: 1024,
  height: 536,
  fit: "cover",
  format: "jpg",
  quality: 82,
});
const ogImageUrl = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#F3F0E8" />

    <title>{title}</title>

    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="Гера2, пескоструйный аппарат, пескоструй, очистка, обработка поверхностей, промышленное оборудование"
    />
    <meta name="author" content="Гера2" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph for social media -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:site_name" content="Гера2" />
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta
      property="og:image:width"
      content={String(ogImage.attributes.width)}
    />
    <meta
      property="og:image:height"
      content={String(ogImage.attributes.height)}
    />
    <meta
      property="og:image:alt"
      content="Металлическая деталь, наполовину очищенная от ржавчины аппаратом Гера2"
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body id="page-content">
    <slot />
  </body>
</html>
