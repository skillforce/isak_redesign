---
import {
  COMPRESSOR_OPTIONS,
  MEDIA_SECTION_DATA,
  TOOL_OPTIONS,
} from "../shared/data/mediaSectionData";
import Icon from "../shared/components/Icon.astro";
import { MODAL_DATA } from "../shared/data/modal_data";
import { CONFIGURATOR } from "../shared/data/pageContent";
import Sticker from "../shared/components/Sticker.astro";

const complectations = TOOL_OPTIONS[0].options;
---

<section
  class="config"
  id="tool_options"
  data-configurator
  aria-labelledby="config-title"
>
  <div class="container">
    <h2 class="display-heading config-title" id="config-title">
      <span class="heading-line">{CONFIGURATOR.TITLE}</span>{" "}
      <Sticker tone="accent" size="heading" shape="tape" tilt="right">
        ГЕРА<span class="brand-number">2</span>.
      </Sticker>
    </h2>

    <ol class="stepper" aria-label="Шаги подбора">
      <li class="is-current" data-step="1">
        <span class="step-badge">01</span>
        {CONFIGURATOR.STEP_MODEL}
      </li>
      <li class="step-line" aria-hidden="true"></li>
      <li data-step="2">
        <span class="step-badge">02</span>
        {CONFIGURATOR.STEP_KIT}
      </li>
    </ol>

    <div class="config-grid">
      <form class="steps" data-config-form onsubmit="return false" novalidate>
        <!-- Compressor -->
        <fieldset class="group" data-compressor-step>
          <legend class="group-title">{CONFIGURATOR.COMPRESSOR}</legend>
          <div class="segmented">
            {
              COMPRESSOR_OPTIONS.filter((opt) => opt.flow !== null).map(
                (opt) => (
                  <label
                    class:list={["seg", { "seg--wide": opt.flow === null }]}
                  >
                    <input type="radio" name="compressor" value={opt.value} />
                    <span>{opt.label}</span>
                  </label>
                )
              )
            }
          </div>

          <div class="help-box" data-help-box hidden>
            <p>
              Эко — от 200 л/мин, Классик и Титан — от 300 л/мин на выходе.
              Пришлите продавцу модель компрессора, и он подскажет аппарат.
            </p>
            <button
              type="button"
              class="help-btn"
              data-modal-trigger={MODAL_DATA.CONTACT_MODAL_ID}
              data-modal-name="помощь с выбором"
              data-modal-message={CONFIGURATOR.HELP_MESSAGE}
            >
              Спросить продавца <Icon size={18} />
            </button>
          </div>
        </fieldset>

        <!-- Model -->
        <fieldset class="group group--list" data-model-step>
          <legend class="visually-hidden">{CONFIGURATOR.STEP_MODEL}</legend>
          <div class="rows">
            {
              TOOL_OPTIONS.map((tool, i) => (
                <label class="row" data-model-choice={i}>
                  <input
                    type="radio"
                    name="model"
                    value={i}
                    data-min-flow={tool.minFlow}
                    aria-describedby={`model-reason-${i}`}
                  />
                  <span class="radio" aria-hidden="true" />
                  <span class="row-body">
                    <span class="row-title">{tool.toolName}</span>
                    <span class="row-desc">
                      {CONFIGURATOR.MODEL_DESCRIPTIONS[i]}
                    </span>
                    <span
                      class="row-reason"
                      id={`model-reason-${i}`}
                      data-model-reason
                      hidden
                    >
                      Недоступно: нужен компрессор от {tool.minFlow} л/мин, а
                      выбран 200–299 л/мин.
                    </span>
                  </span>
                  <span class="row-thumb" aria-hidden="true">
                    <img
                      src={tool.image.src}
                      width={tool.image.width}
                      height={tool.image.height}
                      alt={`Пескоструйный аппарат Гера2 «${tool.toolName}»`}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <span class="row-state" aria-hidden="true">
                    Выбрано
                  </span>
                </label>
              ))
            }
          </div>
          <p class="row-meta t-label" data-model-meta hidden></p>
          <p class="status" aria-live="polite" data-model-status></p>
        </fieldset>

        <!-- Complectation -->
        <fieldset class="group group--list" data-complectation-step disabled>
          <legend class="group-title group-title--kit">
            {CONFIGURATOR.KIT_HEADING}
          </legend>
          <p class="group-hint" data-complectation-hint>
            Сначала выберите модель — цена зависит от неё.
          </p>
          <div class="rows">
            {
              complectations.map((opt, i) => (
                <label class="row row--kit">
                  <input type="radio" name="kit" value={i} />
                  <span class="radio" aria-hidden="true" />
                  <span class="row-body">
                    <span class="row-kit" title={opt.text}>
                      {CONFIGURATOR.KIT_LABELS[i]}
                    </span>
                  </span>
                  <span class="row-thumb row-thumb--kit" aria-hidden="true">
                    <img
                      src={opt.optionImage.src}
                      width={opt.optionImage.width}
                      height={opt.optionImage.height}
                      alt={`Комплектация Гера2: ${opt.text}`}
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                  <span class="row-state" aria-hidden="true">
                    Выбрано
                  </span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <details class="after-list">
          <summary>Помощь с выбором и заявкой</summary>
          <label class="help-compressor"
            ><input type="radio" name="compressor" value="unknown" /> Не знаю производительность
            компрессора</label
          >
          <p class="order-note">{MEDIA_SECTION_DATA.ORDER_NOTE}</p>
          <div class="after-actions">
            <button type="button" class="text-btn" data-copy-order disabled>
              Скопировать текст заявки
            </button>
            <button type="button" class="text-btn" data-config-reset>
              Сбросить выбор
            </button>
            <span class="copy-status" aria-live="polite" data-copy-status
            ></span>
          </div>
        </details>
      </form>

      <!-- Summary: sticky on the right (desktop) / at the bottom (mobile) -->
      <aside
        class="summary on-dark"
        id="config-summary"
        aria-label="Итог подбора"
        data-summary
      >
        <div class="sum-top">
          <div class="sum-main">
            <p class="sum-name">
              <span data-sum-name>Ваш ГЕРА</span><span
                class="sum-brand-number"
                data-sum-brand-number>2</span
              >
            </p>
            <p class="sum-sub t-label" data-sum-sub>
              Выберите модель и комплектацию
            </p>
          </div>
          <p class="sum-price" aria-live="polite">
            <span class="visually-hidden">Цена: </span>
            <span data-only="by" style="display: none;" data-sum-price-by
              >—</span
            >
            <span data-only="other" data-sum-price-other>—</span>
          </p>
        </div>

        <dl class="sum-list">
          <div>
            <dt>Компрессор</dt>
            <dd data-sum-compressor>Не выбран</dd>
          </div>
          <div>
            <dt>Модель</dt>
            <dd data-sum-model>Не выбрана</dd>
          </div>
          <div>
            <dt>Комплектация</dt>
            <dd data-sum-kit>Не выбрана</dd>
          </div>
        </dl>

        <button
          type="button"
          class="sum-order"
          data-modal-trigger={MODAL_DATA.CONTACT_MODAL_ID}
          data-order-button
          data-modal-name="аппарат Гера2"
        >
          {MEDIA_SECTION_DATA.ORDER_TITLE}
          <Icon size={18} />
        </button>
        <p class="sum-hint" data-order-hint aria-live="polite">
          Сначала выберите модель и комплектацию
        </p>
        <p class="sum-caption t-label">{CONFIGURATOR.ORDER_CAPTION}</p>
      </aside>
    </div>
  </div>
</section>

<script>
  import {
    TOOL_OPTIONS,
    COMPRESSOR_OPTIONS,
  } from "../shared/data/mediaSectionData";
  import { CONFIGURATOR } from "../shared/data/pageContent";
  import { MODAL_DATA } from "../shared/data/modal_data";
  import { buildOrderMessage, copyText } from "../shared/utils/order";

  const root = document.querySelector<HTMLElement>("[data-configurator]");

  if (root) {
    const form = root.querySelector<HTMLFormElement>("[data-config-form]")!;
    const q = <T extends HTMLElement = HTMLElement>(sel: string) =>
      root.querySelector<T>(sel);

    const helpBox = q("[data-help-box]");
    const modelInputs = Array.from(
      form.querySelectorAll<HTMLInputElement>('input[name="model"]')
    );
    const kitStep = q<HTMLFieldSetElement>("[data-complectation-step]")!;
    const compressorStep = q<HTMLFieldSetElement>("[data-compressor-step]")!;
    const kitHint = q("[data-complectation-hint]");
    const modelStatus = q("[data-model-status]");
    const modelMeta = q("[data-model-meta]");
    const steps = Array.from(root.querySelectorAll<HTMLElement>("[data-step]"));

    const sum = {
      name: q("[data-sum-name]"),
      sub: q("[data-sum-sub]"),
      compressor: q("[data-sum-compressor]"),
      model: q("[data-sum-model]"),
      kit: q("[data-sum-kit]"),
      priceBy: q("[data-sum-price-by]"),
      priceOther: q("[data-sum-price-other]"),
      order: q<HTMLButtonElement>("[data-order-button]"),
      hint: q("[data-order-hint]"),
      copy: q<HTMLButtonElement>("[data-copy-order]"),
      copyStatus: q("[data-copy-status]"),
    };

    const formatPrice = (value: number, currency: "BYN" | "RUB") =>
      `${value.toLocaleString("ru-RU")} ${currency}`;

    const checkedValue = (name: string) =>
      form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)
        ?.value ?? null;

    const isBY = () => document.documentElement.dataset.isBy === "1";

    function currentState() {
      const compressor = checkedValue("compressor");
      const modelValue = checkedValue("model");
      const kitValue = checkedValue("kit");
      const toolIndex = modelValue === null ? -1 : Number(modelValue);
      const kitIndex = kitValue === null ? -1 : Number(kitValue);
      const tool = toolIndex >= 0 ? TOOL_OPTIONS[toolIndex] : null;
      const kit = tool && kitIndex >= 0 ? tool.options[kitIndex] : null;
      return { compressor, toolIndex, kitIndex, tool, kit };
    }

    function syncAvailability() {
      const compressor = checkedValue("compressor");
      const flow =
        COMPRESSOR_OPTIONS.find((o) => o.value === compressor)?.flow ?? null;
      let dropped: string | null = null;

      modelInputs.forEach((input) => {
        const minFlow = Number(input.dataset.minFlow);
        const unavailable = flow !== null && flow < minFlow;
        const label = input.closest<HTMLElement>("label")!;
        const reason = label.querySelector<HTMLElement>("[data-model-reason]");

        if (unavailable && input.checked) {
          input.checked = false;
          dropped = TOOL_OPTIONS[Number(input.value)].toolName;
        }
        input.disabled = unavailable;
        label.classList.toggle("is-disabled", unavailable);
        if (reason) reason.hidden = !unavailable;
      });

      if (helpBox) helpBox.hidden = compressor !== "unknown";

      if (modelStatus) {
        modelStatus.textContent = dropped
          ? `Модель «${dropped}» недоступна для компрессора 200–299 л/мин — выбор снят.`
          : flow === 200
            ? "Для компрессора 200–299 л/мин доступна модель Эко"
            : "";
      }
    }

    function orderName() {
      const { tool, kit, kitIndex, compressor } = currentState();
      if (!tool || !kit) return "аппарат Гера2";
      const price = isBY()
        ? formatPrice(kit.price.BY, "BYN")
        : formatPrice(kit.price.RU, "RUB");
      const compressorLabel = COMPRESSOR_OPTIONS.find(
        (o) => o.value === compressor
      )?.label;
      return [
        `аппарат Гера2 «${tool.toolName}»`,
        `комплектация ${kitIndex + 1}: ${kit.text}`,
        `цена ${price}`,
        compressorLabel && compressor !== "unknown"
          ? `компрессор ${compressorLabel}`
          : null,
      ]
        .filter(Boolean)
        .join(", ");
    }

    function render() {
      const { compressor, tool, kit, kitIndex, toolIndex } = currentState();
      const compressorLabel =
        COMPRESSOR_OPTIONS.find((o) => o.value === compressor)?.label ?? null;
      const ready = Boolean(compressor && tool && kit);

      kitStep.disabled = !tool;
      if (kitHint) kitHint.hidden = Boolean(tool);

      if (modelMeta) {
        modelMeta.hidden = !tool;
        modelMeta.textContent = tool
          ? `Компрессор от ${tool.minFlow} л/мин`
          : "";
      }

      steps.forEach((step) => {
        const n = Number(step.dataset.step);
        const current = tool ? 2 : 1;
        step.classList.toggle("is-current", n === current);
        step.classList.toggle("is-done", n < current);
        if (n === current) step.setAttribute("aria-current", "step");
        else step.removeAttribute("aria-current");
      });

      if (sum.name) {
        sum.name.textContent = tool
          ? `${tool.toolName}${kit ? ` · ${CONFIGURATOR.KIT_LABELS[kitIndex]}` : ""}`
          : "Ваш ГЕРА";
      }
      const brandNumber = q("[data-sum-brand-number]");
      if (brandNumber) brandNumber.hidden = Boolean(tool);
      if (sum.sub) {
        sum.sub.textContent = tool
          ? `Компрессор от ${tool.minFlow} л/мин`
          : "Выберите модель и комплектацию";
      }
      if (sum.compressor)
        sum.compressor.textContent = compressorLabel ?? "Не выбран";
      if (sum.model)
        sum.model.textContent = tool ? tool.toolName : "Не выбрана";
      if (sum.kit) {
        sum.kit.textContent = kit
          ? `Комплектация ${kitIndex + 1}. ${kit.text}`
          : "Не выбрана";
      }

      const by = kit ? formatPrice(kit.price.BY, "BYN") : "—";
      const other = kit ? formatPrice(kit.price.RU, "RUB") : "—";
      if (sum.priceBy) sum.priceBy.textContent = by;
      if (sum.priceOther) sum.priceOther.textContent = other;

      if (sum.order) {
        sum.order.toggleAttribute("aria-disabled", !ready);
        sum.order.dataset.modalName = ready ? orderName() : "аппарат Гера2";
      }
      if (sum.hint) {
        sum.hint.textContent = ready
          ? "Выбор готов — можно обсудить заказ"
          : !compressor
            ? "Сначала выберите компрессор или вариант «Не знаю»"
            : tool
              ? "Выберите комплектацию, чтобы продолжить"
              : "Выберите модель, затем комплектацию, чтобы продолжить";
      }
      if (sum.copy) sum.copy.disabled = !ready;
      if (sum.copyStatus) sum.copyStatus.textContent = "";

      root!.dataset.selectedModel = String(toolIndex);
    }

    form.addEventListener("change", (event) => {
      const target = event.target as HTMLInputElement;
      if (target.name === "compressor") syncAvailability();
      render();
    });

    sum.order?.addEventListener(
      "click",
      (event) => {
        const { compressor, tool, kit } = currentState();
        if (compressor && tool && kit) return;
        event.preventDefault();
        event.stopImmediatePropagation();

        const group = !compressor
          ? compressorStep
          : !tool
            ? form.querySelector<HTMLElement>("[data-model-step]")
            : kitStep;
        const input = !compressor
          ? compressorStep.querySelector<HTMLInputElement>(
              'input[name="compressor"]:not(:disabled)'
            )
          : !tool
            ? modelInputs.find((candidate) => !candidate.disabled)
            : kitStep.querySelector<HTMLInputElement>(
                'input[name="kit"]:not(:disabled)'
              );
        if (!group || !input) return;

        group.classList.remove("needs-attention");
        void group.offsetWidth;
        group.classList.add("needs-attention");
        group.addEventListener(
          "animationend",
          () => group.classList.remove("needs-attention"),
          { once: true }
        );
        group.scrollIntoView({ behavior: "smooth", block: "center" });
        window.setTimeout(() => input.focus({ preventScroll: true }), 350);
      },
      true
    );

    sum.copy?.addEventListener("click", async () => {
      const ok = await copyText(buildOrderMessage(orderName()));
      if (sum.copyStatus) {
        sum.copyStatus.textContent = ok
          ? "Текст заявки скопирован"
          : "Не удалось скопировать — текст есть в окне контактов";
      }
    });

    q("[data-config-reset]")?.addEventListener("click", () => {
      form.reset();
      syncAvailability();
      render();
      form.querySelector<HTMLInputElement>("input")?.focus();
    });

    // Rows in «Под вашу задачу» preselect a model here.
    document
      .querySelectorAll<HTMLElement>("[data-pick-model]")
      .forEach((link) => {
        link.addEventListener("click", () => {
          const input = modelInputs[Number(link.dataset.pickModel)];
          if (input && !input.disabled) {
            input.checked = true;
            render();
          }
        });
      });

    window.addEventListener("geo:by", () => render());

    syncAvailability();
    render();
  }
</script>

<style>
  .config {
    padding-block: 56px 96px;
    border-top: 1px solid var(--c-ink);
  }

  .config-title {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.1em 0.3em;
    font-size: clamp(36px, 5.3vw, 76px);
  }

  .brand-number {
    position: relative;
    top: -0.35em;
    margin-left: 0.04em;
    font-size: 0.55em;
  }

  /* ——— Stepper ——— */
  .stepper {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 28px;
    padding-bottom: 16px;
    border-bottom: 2px solid var(--c-ink);
    font-size: 17px;
    font-weight: 500;
  }

  .stepper li {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    color: var(--c-muted);
  }

  .stepper .step-line {
    width: 28px;
    height: 1.5px;
    background: var(--c-ink);
  }

  .step-badge {
    font-family: var(--f-mono);
    font-size: 15px;
    padding: 3px 8px;
  }

  .stepper li.is-current,
  .stepper li.is-done {
    color: var(--c-ink);
  }

  .stepper li.is-current .step-badge {
    background: var(--c-accent);
    color: var(--c-white);
  }

  .stepper li.is-done .step-badge {
    background: var(--c-ink);
    color: var(--c-ivory);
  }

  /* ——— Layout ——— */
  .config-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(340px, 420px);
    gap: 56px;
    align-items: start;
    margin-top: 36px;
  }

  .steps {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .group {
    min-width: 0;
    padding: 0;
    margin: 0;
  }

  .group + .group {
    margin-top: 28px;
  }

  .group-title {
    padding: 0;
    margin-bottom: 18px;
    font-family: var(--f-heading);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.25;
    letter-spacing: -0.035em;
  }

  .group-title--kit {
    padding-top: 28px;
    width: 100%;
    border-top: 2px solid var(--c-ink);
  }

  .group-hint {
    margin: -8px 0 14px;
    color: var(--c-muted);
    font-size: 15px;
  }

  .group-hint[hidden] {
    display: none;
  }

  /* ——— Segmented compressor control ——— */
  .segmented {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 1.5px solid var(--c-ink);
  }

  .seg {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 52px;
    padding: 8px 12px;
    font-family: var(--f-mono);
    font-size: 16px;
    font-weight: 500;
    text-align: center;
    cursor: pointer;
    transition:
      background-color var(--t) var(--ease),
      color var(--t) var(--ease);
  }

  .seg + .seg:not(.seg--wide) {
    border-left: 1.5px solid var(--c-ink);
  }

  .seg--wide {
    grid-column: 1 / -1;
    border-top: 1.5px solid var(--c-ink);
    font-size: 15px;
  }

  .seg input,
  .row input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }

  .seg:hover {
    background: rgb(200 194 184 / 0.35);
  }

  .seg:has(input:checked) {
    background: var(--c-ink);
    color: var(--c-ivory);
  }

  .seg:has(input:focus-visible),
  .row:has(input:focus-visible) {
    outline: 3px solid var(--c-ink);
    outline-offset: 2px;
    z-index: 1;
  }

  .help-box {
    margin-top: 14px;
    padding: 16px 18px;
    background: var(--c-white);
    border-left: 4px solid var(--c-accent-hover);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    font-size: 15px;
  }

  .help-box[hidden] {
    display: none;
  }

  .help-btn {
    min-height: 44px;
    padding: 0 18px;
    border: 1.5px solid var(--c-ink);
    background: transparent;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
  }

  .help-btn:hover {
    background: var(--c-ink);
    color: var(--c-ivory);
  }

  /* ——— Option rows ——— */
  .rows {
    border-top: 1px solid var(--c-ink);
  }

  .group--list:first-of-type .rows,
  .segmented + .help-box + .rows {
    margin-top: 0;
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 26px minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 22px;
    min-height: 68px;
    padding: 12px 16px 12px 22px;
    border-bottom: 1px solid var(--c-ink);
    cursor: pointer;
    transition: background-color var(--t) var(--ease);
  }

  .row::before {
    content: "";
    position: absolute;
    left: 0;
    top: -1px;
    bottom: -1px;
    width: 5px;
    background: var(--c-accent);
    transform: scaleY(0);
    transition: transform var(--t) var(--ease);
  }

  @media (hover: hover) {
    .row:hover {
      background: rgb(200 194 184 / 0.25);
    }
  }

  .radio {
    width: 26px;
    height: 26px;
    border: 1.5px solid var(--c-ink);
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: var(--c-ivory);
  }

  .radio::after {
    content: "";
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--c-accent);
    transform: scale(0);
    transition: transform var(--t) var(--ease);
  }

  .row-body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
