---
import VideoEmbed from "../shared/components/VideoEmbed.astro";
import { MEDIA_SECTION_DATA } from "../shared/data/mediaSectionData";
import { VIDEO } from "../shared/data/pageContent";
import metalTexture from "../assets/backgroundSecondary.avif";
import BrandText from "../shared/components/BrandText.astro";
import Sticker from "../shared/components/Sticker.astro";

const videos = MEDIA_SECTION_DATA.VIDEOS.filter((v) => v.id?.trim());
---

<section class="video-section on-dark" id="video" aria-labelledby="video-title">
  <div class="container">
    <p class="section-kicker video-label">
      <Sticker tone="paper" icon="play"
        ><BrandText text={VIDEO.LABEL} /></Sticker
      >
    </p>
    <h2 class="display-heading video-title" id="video-title">
      <span class="heading-line">{VIDEO.TITLE[0]}</span>{" "}
      <Sticker tone="acid" size="heading" shape="tape" tilt="right"
        >{VIDEO.TITLE[1]}</Sticker
      >
    </h2>
    <p class="video-sub">{VIDEO.CAPTION}</p>

    <div class="video-list">
      {
        videos.length > 0 ? (
          videos.map((video, i) => (
            <div class="video-frame">
              <VideoEmbed
                videoId={video.id}
                poster={video.poster}
                fallback={metalTexture}
                title={`ГЕРА₂ в работе — ролик ${i + 1}`}
              />
            </div>
          ))
        ) : (
          <div class="video-frame">
            <VideoEmbed fallback={metalTexture} title="ГЕРА₂ в работе" />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .video-section {
    background: var(--c-ink);
    color: var(--c-ivory);
    padding-block: 64px 56px;
  }

  .video-title {
    margin-top: 32px;
    font-size: clamp(36px, 6.2vw, 88px);
  }

  .video-sub {
    margin-top: 24px;
    font-size: clamp(18px, 1.8vw, 26px);
    line-height: 1.35;
  }

  .video-list {
    display: grid;
    gap: 32px;
    margin-top: 40px;
    width: min(50%, 720px);
    margin-inline: auto;
  }

  .video-frame {
    border-radius: 6px;
    overflow: hidden;
  }

  @media (max-width: 767px) {
    .video-section {
      padding-block: 48px;
    }

    .video-title {
      font-size: clamp(32px, 9.4vw, 60px);
      margin-top: 28px;
    }

    .video-sub {
      margin-top: 14px;
    }

    .video-list {
      gap: 20px;
      margin-top: 28px;
      width: 100%;
    }
  }
</style>
